              <TouchableOpacity onPress={() => setPickerAnoHeader(pickerAnoHeader - 1)}><Ionicons name="chevron-back" size={24} color={colors.text}/></TouchableOpacity>
              <Text style={[styles.pickerYear, { color: colors.text }]}>{pickerAnoHeader}</Text>
