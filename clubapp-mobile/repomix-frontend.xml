              >
                 <Ionicons name="trash-outline" size={18} color="#ef4444"/>
              </TouchableOpacity>
          </View>
        </View>
      </TouchableOpacity>
    )
})}
          {transacoesExibidas.length === 0 && <Text style={styles.emptyText}>Nenhum lançamento neste mês.</Text>}
