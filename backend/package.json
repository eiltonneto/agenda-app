{
  "name": "clubapp-backend",
  "version": "1.0.0",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "dev:local": "cross-env DATABASE_URL=postgresql://dev:dev123@localhost:5432/yourflow_dev nodemon src/server.js",
    "dev:prod": "nodemon src/server.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose stop",
    "db:reset": "docker compose down -v && docker compose up -d && npx prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "start": "node src/server.js"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.6",
    "dotenv": "^16.0.0",
    "express": "^4.19.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "nodemon": "^3.0.0",
    "prisma": "^6.0.0"
  }
}
