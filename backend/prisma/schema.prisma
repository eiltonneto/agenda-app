// Coração do banco de dados do projeto. Arquivo de configuração principal do Prisma ORM -> ferramenta que traduz o código JS para a
linguagem de banco de dados (SQL).

// Serve para modelar os dados: Estrutura que será salvo. Gerar tipagem, e sincronizar com o banco de dados real.

generator client { // Diz ao prisma para criar um "cliente" de código
  provider = "prisma-client-js"
}

datasource db { // Define a conexão
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// MODELS: Cada model representa uma tabela no banco de dados (PostgreSQL)

model Usuario {
  id           Int           @id @default(autoincrement())
  nome         String
  email        String        @unique
  senhaHash    String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt 
  foto         String?
  Despesa      Despesa[]
  eventos      Evento[]
  notificacoes Notificacao[]
  Receita      Receita[]
}

model Evento {
  id               String   @id @default(cuid())
  titulo           String
  inicio           DateTime
  fim              DateTime
  tipo             String   // Você pode mudar para TipoEvento depois
  cor_categoria    String
  descricao        String?
  categoria_id     String?  // Representa o local físico (Campo 1, Campo 2, etc)
  lembrete_minutos Int?     
  usuarioId        Int
  usuario          Usuario  @relation(fields: [usuarioId], references: [id])
  comparecido      Boolean @default(false)

  @@index([categoria_id])   // Melhora a performance na busca por conflito de local
}

model Notificacao {
  id             Int             @id @default(autoincrement())
  tipo           TipoNotificacao
  titulo         String
  mensagem       String
  disparoEm      DateTime
  lida           Boolean         @default(false)
  referenciaTipo String?
  referenciaId   Int?
  usuarioId      Int
  createdAt      DateTime        @default(now())
  usuario        Usuario         @relation(fields: [usuarioId], references: [id])
}

model Despesa {
  id              Int              @id @default(autoincrement())
  categoria       CategoriaDespesa
  descricao       String
  valor           Decimal          @db.Decimal(10, 2)
  status          StatusDespesa    @default(PENDENTE)
  
  // 🗓️ Estrutura Final Única
  eventDate       DateTime?        // Data do compromisso
  paidAt          DateTime?        // Data do pagamento real
  createdAt       DateTime         @default(now())
  
  eventId         String?          
  usuarioId       Int
  Usuario         Usuario          @relation(fields: [usuarioId], references: [id])
}

model Receita {
  id            Int           @id @default(autoincrement())
  tipo          TipoReceita
  descricao     String
  valor         Decimal       @db.Decimal(10, 2)
  status        StatusReceita @default(PENDENTE)
  
  // 🗓️ Estrutura Final Única
  eventDate     DateTime?     // Data do atendimento (Agenda)
  paidAt        DateTime?     // Data do recebimento (Caixa)
  createdAt     DateTime      @default(now())

  eventId       String?       
  usuarioId     Int
  Usuario       Usuario       @relation(fields: [usuarioId], references: [id])
}

enum TipoEvento {
  RACHA
  EVENTO_CLUBE
  FESTA
  REUNIAO
  MANUTENCAO
  OUTRO
}

enum TipoNotificacao {
  EVENTO
  DESPESA
  RECEITA
  OUTRO
}

enum CategoriaDespesa {
  FIXA
  VARIAVEL
  COMPRA_PRODUTO
  MANUTENCAO
  OUTRO
}

enum StatusDespesa {
  PENDENTE
  PAGA
  ATRASADA
}

enum StatusReceita {
  PENDENTE
  RECEBIDA
  CANCELADA
}

enum TipoReceita {
  VENDA
  SERVICO
  ALUGUEL
  OUTRO
}
