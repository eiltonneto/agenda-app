generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Usuario {
  id           Int           @id @default(autoincrement())
  nome         String
  email        String        @unique
  senhaHash    String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt // 👈 Agora o Prisma gera isso sozinho!
  foto         String?
  Despesa      Despesa[]
  eventos      Evento[]
  notificacoes Notificacao[]
  Receita      Receita[]
}

model Evento {
  id               String   @id @default(cuid())
  titulo           String
  inicio           DateTime
  fim              DateTime
  tipo             String   // Você pode mudar para TipoEvento depois
  cor_categoria    String
  descricao        String?
  categoria_id     String?  // 👈 Representa o local físico (Campo 1, Campo 2, etc)
  lembrete_minutos Int?     // 👈 Corrigido o erro de sintaxe aqui
  usuarioId        Int
  usuario          Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([categoria_id])   // Melhora a performance na busca por conflito de local
}

model Notificacao {
  id             Int             @id @default(autoincrement())
  tipo           TipoNotificacao
  titulo         String
  mensagem       String
  disparoEm      DateTime
  lida           Boolean         @default(false)
  referenciaTipo String?
  referenciaId   Int?
  usuarioId      Int
  createdAt      DateTime        @default(now())
  usuario        Usuario         @relation(fields: [usuarioId], references: [id])
}

model Despesa {
  id             Int              @id @default(autoincrement())
  categoria      CategoriaDespesa
  descricao      String
  valor          Decimal          @db.Decimal(10, 2)
  dataVencimento DateTime
  dataPagamento  DateTime?
  status         StatusDespesa    @default(PENDENTE)
  usuarioId      Int
  createdAt      DateTime         @default(now())
  Usuario        Usuario          @relation(fields: [usuarioId], references: [id])
}

model Receita {
  id           Int           @id @default(autoincrement())
  tipo         TipoReceita
  descricao    String
  valor        Decimal       @db.Decimal(10, 2)
  dataPrevista DateTime?
  dataRecebida DateTime?
  status       StatusReceita @default(PENDENTE)
  usuarioId    Int
  createdAt    DateTime      @default(now())
  Usuario      Usuario       @relation(fields: [usuarioId], references: [id])
}

enum TipoEvento {
  RACHA
  EVENTO_CLUBE
  FESTA
  REUNIAO
  MANUTENCAO
  OUTRO
}

enum TipoNotificacao {
  EVENTO
  DESPESA
  RECEITA
  OUTRO
}

enum CategoriaDespesa {
  FIXA
  VARIAVEL
  COMPRA_PRODUTO
  MANUTENCAO
  OUTRO
}

enum StatusDespesa {
  PENDENTE
  PAGA
  ATRASADA
}

enum StatusReceita {
  PENDENTE
  RECEBIDA
  CANCELADA
}

enum TipoReceita {
  VENDA
  SERVICO
  ALUGUEL
  OUTRO
}
